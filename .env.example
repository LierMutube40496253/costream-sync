# Copy to .env and fill in. .env is gitignored: never commit real values.
# Without DISCORD_CLIENT_ID the server runs in dev mode (name + room, no Discord).

# Sync server
COSTREAM_HOST=127.0.0.1
COSTREAM_PORT=8765

# Discord login (docs/DISCORD_SETUP.md). The client id is public (it's in the login link);
# no client secret is needed: panel and extension log in themselves with scope "identify".
DISCORD_CLIENT_ID=1562864672854646875

# Discord bot (python -m server.bot): reports who is in which voice channel.
DISCORD_BOT_TOKEN=your-discord-bot-token
# Shared key between the bot and the server. Any long random string, e.g. from:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_SHARED_SECRET=your-long-random-string

# Only if the bot runs on another machine than the server:
# COSTREAM_BOT_SERVER=ws://127.0.0.1:8765/ws
